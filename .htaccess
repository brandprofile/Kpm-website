# KPM Car Transportation: Hostinger (Apache / LiteSpeed) settings
# Security headers, HTTPS, caching and compression for the static site.

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Always HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Always www (matches the canonical URLs in the site)
  RewriteCond %{HTTP_HOST} ^cartransportation\.co\.in$ [NC]
  RewriteRule ^ https://www.cartransportation.co.in%{REQUEST_URI} [L,R=301]

  # 3. Block hidden files and backups (.git, .env, *.bak, *.zip, *.sql ...)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(bak|old|orig|sql|zip|tar|gz|log|ini|sh|env|md|lock|config)$ - [F,L,NC]

  # 4. Block common attack probes on a static site (no PHP or WordPress here)
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|xmlrpc\.php|phpmyadmin|cgi-bin)(/|$) - [F,L,NC]
  RewriteCond %{REQUEST_URI} !^/(lead|visit)\.php$
  RewriteRule \.php$ - [F,L,NC]

  # 5. Only allow normal page methods
  # (the lead logger /lead.php and ad-visit logger /visit.php also accept POST)
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
  RewriteCond %{REQUEST_URI} !^/(lead|visit)\.php$
  RewriteRule ^ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Content Security Policy: only our own files plus Google Ads / Analytics / Tag Manager,
  # Meta Pixel, YouTube videos, WhatsApp and the optional Web3Forms lead endpoint.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://connect.facebook.net https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://www.facebook.com https://connect.facebook.net https://api.web3forms.com https://script.google.com https://script.googleusercontent.com; frame-src 'self' https://www.youtube-nocookie.com https://www.googletagmanager.com https://td.doubleclick.net https://www.google.com; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me https://api.whatsapp.com https://api.web3forms.com; frame-ancestors 'self'; upgrade-insecure-requests"

  # Caching: pages always fresh, versioned files cached for a year
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(json|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddDefaultCharset utf-8
